# AIKrub Admin Frontend — Environment Variables
# Copy this file to .env.local and fill in the real values before running dev.
# NEVER commit .env.local to git.

# Worker API base URL (shared Worker — admin routes are at /api/admin/*)
VITE_API_URL=https://aikrub-api.office-aikrub.workers.dev

# Supabase — same project as main AIKrub repo (same DB, same RLS)
VITE_SUPABASE_URL=https://nenrhsiyepxaemhclctl.supabase.co

# Supabase anon key — public (safe in browser), but do NOT commit your real value here.
# Get the real value from: C:\Users\Admin\Documents\AIKrub-secrets\credentials.env
VITE_SUPABASE_ANON_KEY=<copy SUPABASE_ANON_KEY from credentials.env>
